FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Dependency layer: install against a stub package so this layer is only rebuilt when
# pyproject.toml changes, not on every source edit. The editable install points at /app/src,
# so the real code copied below is what runs.
# The API only needs core + rag (document parsing + local embeddings); provider SDKs live in the agent.
COPY pyproject.toml README.md ./
RUN mkdir -p src/ofd && touch src/ofd/__init__.py && pip install -e ".[rag]"

# Source layer (fast to rebuild).
COPY src ./src
COPY migrations ./migrations
COPY scripts ./scripts
COPY alembic.ini ./

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["ofd-api"]
