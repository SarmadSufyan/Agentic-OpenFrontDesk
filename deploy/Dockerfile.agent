# Voice agent worker (LiveKit).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Dependency layer: install against a stub package so it is only rebuilt when pyproject.toml
# changes. agent = livekit-agents + realtime plugins; rag = local embeddings for search_knowledge.
COPY pyproject.toml README.md ./
RUN mkdir -p src/ofd && touch src/ofd/__init__.py && pip install -e ".[agent,rag]"

# Bake plugin model files (Silero VAD, turn detector) into this cached layer so neither code
# edits nor the first call trigger a download.
RUN python -c "from livekit.plugins import silero, turn_detector; from livekit.agents import Plugin; [p.download_files() for p in Plugin.registered_plugins]"

# Source layer (fast to rebuild).
COPY src ./src

# LiveKit CLI needs a subcommand; "start" runs the worker in production mode.
CMD ["ofd-agent", "start"]
