# Voice agent worker (LiveKit).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
# agent = livekit-agents + realtime plugins; rag = local embeddings for the search_knowledge tool.
# (The raw provider SDKs are not needed here; the realtime path uses LiveKit plugins.)
RUN pip install -e ".[agent,rag]"

# Pre-download plugin model files (Silero VAD, turn detector) so the first call is not slow.
RUN ofd-agent download-files || true

# LiveKit CLI needs a subcommand; "start" runs the worker in production mode.
CMD ["ofd-agent", "start"]
