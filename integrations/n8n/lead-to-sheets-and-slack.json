{
  "id": "OfdLeadsToSheets",
  "name": "OpenFrontDesk: new lead to Google Sheets and Slack",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "openfrontdesk-leads",
        "responseMode": "onReceived",
        "options": {
          "rawBody": true
        }
      },
      "id": "5b0d8a4e-1c1f-4f7e-9a51-0c6f1d7e2a01",
      "name": "OpenFrontDesk event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "0f3a9a8e-7c55-4b8e-a1f2-8d9b6c2e4a01"
    },
    {
      "parameters": {
        "jsCode": "// Verifies the X-OFD-Signature header (HMAC-SHA256 over \"<timestamp>.<raw body>\").\n// Paste the signing secret shown when you created the webhook in OpenFrontDesk.\nconst SECRET = 'whsec_REPLACE_ME';\n\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers;\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst ts = headers['x-ofd-timestamp'];\nconst expected = 'sha256=' + crypto.createHmac('sha256', SECRET).update(`${ts}.`).update(raw).digest('hex');\nconst received = headers['x-ofd-signature'] || '';\nconst valid = received.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(received), Buffer.from(expected));\nif (!valid) throw new Error('Invalid OpenFrontDesk signature');\nif (Math.abs(Date.now() / 1000 - Number(ts)) > 300) throw new Error('Stale OpenFrontDesk event');\n\nreturn [{ json: JSON.parse(raw.toString('utf8')) }];"
      },
      "id": "5b0d8a4e-1c1f-4f7e-9a51-0c6f1d7e2a02",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1a2b3c4-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.type }}",
              "rightValue": "lead.created",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5b0d8a4e-1c1f-4f7e-9a51-0c6f1d7e2a03",
      "name": "Is a new lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
