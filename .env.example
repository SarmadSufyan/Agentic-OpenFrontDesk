# =============================================================================
# OpenFrontDesk — environment configuration
# Copy to `.env` and fill in. Defaults target the FREE ($0) stack.
# See docs/12-costing.md and docs/07-providers.md for the full matrix.
# =============================================================================

# --- App ---
ENV=development                       # development | production
APP_NAME=OpenFrontDesk
API_HOST=0.0.0.0
API_PORT=8000                          # port inside the container (uvicorn)
API_HOST_PORT=8000                     # port published on your machine (change if 8000 is taken)
SECRET_KEY=change-me-to-a-long-random-string   # used to sign JWTs
LOG_LEVEL=INFO
LOG_JSON=false                        # true = structured JSON logs (prod)
CORS_ORIGINS=http://localhost:3000    # comma-separated dashboard origins

# --- Database (Postgres + pgvector) ---
POSTGRES_USER=ofd
POSTGRES_PASSWORD=ofd
POSTGRES_DB=openfrontdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Assembled automatically if left blank:
DATABASE_URL=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (recordings, uploads). Local dir in dev; S3/MinIO in prod ---
STORAGE_BACKEND=local                 # local | s3
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =============================================================================
# PROVIDER SELECTION  (swap free <-> premium with these keys, no code changes)
# =============================================================================
STT_PROVIDER=groq                     # groq | deepgram | faster_whisper
LLM_PROVIDER=groq                     # groq | gemini | anthropic | openai | ollama
TTS_PROVIDER=kokoro                   # kokoro | cartesia | deepgram | elevenlabs
EMBEDDINGS_PROVIDER=fastembed         # fastembed | gemini | openai

# --- Groq (FREE tier: fast STT + LLM) — https://console.groq.com ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b

# --- Google Gemini (FREE tier via AI Studio, NOT Google One) — aistudio.google.com ---
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDINGS_MODEL=text-embedding-004

# --- Kokoro TTS (FREE, self-hosted on the VPS) ---
KOKORO_BASE_URL=http://localhost:8880 # OpenAI-compatible Kokoro-FastAPI server
KOKORO_VOICE=af_heart

# --- Ollama (self-hosted LLM; use for dev/offline, NOT live calls) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Premium providers (added when a client upgrades) ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=

# =============================================================================
# VOICE TRANSPORT + TELEPHONY
# =============================================================================
# LiveKit (FREE "Build" tier: 1000 agent-min/mo) — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Telephony (only needed at GO-LIVE; testing uses the browser mic)
TELEPHONY_PROVIDER=none               # none | telnyx | twilio
TELNYX_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# =============================================================================
# INTEGRATIONS
# =============================================================================
# Scheduling
CALENDAR_BACKEND=internal             # internal (free, no account) | calcom
CALCOM_BASE_URL=https://api.cal.com/v2
CALCOM_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# SMS (confirmations/follow-ups)
SMS_PROVIDER=none                     # none | twilio | telnyx

# --- Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Security / limits ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=120                 # per-tenant API write rate limit
SECURITY_HEADERS=true
RECORDING_ENABLED=false                # call recording (needs consent handling) — off by default

# --- SaaS access control (keeps the free tier fair) ---
MAX_CONCURRENT_VOICE=3                 # simultaneous live voice sessions before users are queued
VOICE_SESSION_TTL_SECONDS=360         # a granted voice slot expires if the client stops heartbeating
ADMIN_EMAILS=                          # comma-separated admin emails (platform admin dashboard/API)
ACCESS_ALLOWLIST=                      # comma-separated emails that skip the voice queue

# --- Automations (outbound webhooks + public /v1 API). See docs/17-automations.md ---
WEBHOOK_ALLOW_PRIVATE=false            # true only to deliver to your own private network (e.g. the bundled n8n)
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3                 # retries on network errors, 5xx, 408 and 429
WEBHOOK_DISABLE_AFTER_FAILURES=25      # auto-disable an endpoint after this many consecutive failures
API_RATE_LIMIT_PER_MIN=120             # per-workspace limit for API-key requests

# --- Custom solutions: contact form, admin inbox, scheduling. See docs/18-contact-and-personalization.md ---
PUBLIC_BASE_URL=http://localhost:8000  # used for links in emails (set to your public URL in production)
SCHEDULING_URL=                        # your Cal.com / Calendly link, e.g. https://cal.com/you/30min
CONTACT_NOTIFY_EMAILS=                 # who is emailed about new requests (defaults to ADMIN_EMAILS)
CONTACT_WEBHOOK_URL=                   # optional Slack incoming webhook / n8n / Zapier URL for new requests
CONTACT_RATE_LIMIT_PER_HOUR=5          # form submissions per client IP
TRUST_PROXY_HEADERS=false              # true when behind nginx/a load balancer that sets X-Forwarded-For

# --- Email (SMTP). Empty SMTP_HOST disables email; requests are still stored and shown in the inbox ---
SMTP_HOST=                             # local testing: mailpit (docker compose --profile mail up -d mailpit)
SMTP_PORT=587                          # mailpit: 1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                             # e.g. OpenFrontDesk <hello@yourdomain.com>
SMTP_STARTTLS=true                     # mailpit: false
SMTP_SSL=false                         # true for implicit TLS (port 465)
